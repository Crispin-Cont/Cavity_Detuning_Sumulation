import numpy as np
import matplotlib.pyplot as plt

class CavitySimulator:
    def __init__(self, tmax=1.0, dt=1e-3, **kwargs):
        """
        Initializes the simulator with physical and simulation parameters.
        
        Args:
            tmax (float): Max simulation time in seconds.
            dt (float): Fixed time step for the solver.
            **kwargs: A dictionary of parameter arrays to override the defaults.
        """
        # --- Simulation Parameters ---
        self.tmax = tmax
        self.dt = dt

        # --- Physical Parameters ---
        self.O = kwargs.get('O', 2 * np.pi * np.array([157, 182, 189, 215, 292, 331, 380, 412, 462, 471]))
        self.tau_mech = kwargs.get('tau_mech', 2 * np.array([56.8, 113.2, 70.38, 25, 300, 304.2, 409.46, 305.11, 202.19, 205.86]) * 1e-3)
        self.kLFD = kwargs.get('kLFD', 2 * np.pi * 2.9636 * np.array([0.02, 0.03, 0.055, 0.55, 0.085, 0.029, 0.052, 0.19, 0.075, 0.095]) * 1e-6)
        self.kpiezo = kwargs.get('kpiezo', 2 * np.pi * 16.9348 * np.array([0.02, 0.03, 0.055, 0.55, 0.085, 0.029, 0.052, 0.19, 0.075, 0.095]))
        self.kmicro = kwargs.get('kmicro', 2 * np.pi * 64.0982 * np.array([0.02, 0.03, 0.055, 0.55, 0.085, 0.029, 0.052, 0.19, 0.075, 0.095]))
        
        self.NUM_MODES = len(self.O)

        # Cavity parameters
        self.Qext = 3e6
        self.Q0 = 2.7e10
        self.beta = self.Q0 / self.Qext
        self.QL = self.Q0 / (1 + self.beta)
        self.w0 = 2 * np.pi * 650e6
        self.whalf = self.w0 / (2 * self.QL)
        self.Leff = 1.038

        # Initial State Vector: [Dw1..DwN, dDwdt1..dDwdtN, v_real, v_imag]
        self.y0 = np.concatenate([np.zeros(2 * self.NUM_MODES), [25.0, 0.0]])
        
        # Fixed inputs for this fixed-step solver version
        self.piezo_control = 0.0
        self.microphonics_control = 0.0

    def _V_forward_drive(self, t):
        tau = 2 * self.QL / self.w0
        Leff = self.Leff
        t1 = 1e-3
        tfill = t1 + tau * np.log(2)
        tflat = tfill + t1
        ratio = (1 - np.exp(-(tfill - t1) / tau))
        Amp = (25e6 * Leff)
        drive = Amp * ((t >= t1) * (t < tfill) + ratio * (t >= tfill) * (t < tflat))
        return drive

    def _coupled_dynamics(self, t, y):
        """
        The dynamics function used by the RK4 solver.
        """
        Dw_array = y[0:self.NUM_MODES]
        dDwdt_array = y[self.NUM_MODES:2*self.NUM_MODES]
        v_real = y[2*self.NUM_MODES]
        v_imag = y[2*self.NUM_MODES + 1]
        
        v_complex = v_real + 1j * v_imag
        
        # Uses fixed inputs from the class instance
        piezo = self.piezo_control
        microphonics = self.microphonics_control
        V_forward = self._V_forward_drive(t)
        
        d_Dw_dt_array = dDwdt_array
        D2wdt2_array = - (2 / self.tau_mech) * dDwdt_array - self.O**2 * Dw_array + self.kLFD * np.abs(v_complex / self.Leff)**2 + self.kpiezo * piezo + self.kmicro * microphonics
        detuning_total = np.sum(Dw_array)
        
        dvdt_complex = (-self.whalf + detuning_total * 1j) * v_complex + 2 * self.whalf * V_forward
        dv_real_dt = dvdt_complex.real
        dv_imag_dt = dvdt_complex.imag
        
        return np.concatenate([d_Dw_dt_array, D2wdt2_array, [dv_real_dt, dv_imag_dt]])
        
    def run_with_rk4(self):
        """
        Runs the full simulation using a fixed-step fourth-order Runge-Kutta (RK4) method.
        Returns a tuple of (t_sol, y_sol).
        """
        t_sol = []
        y_sol = []
        
        t = 0.0
        y = self.y0
        
        num_steps = int(self.tmax / self.dt)
        
        for i in range(num_steps):
            # Store current time and state
            t_sol.append(t)
            y_sol.append(y.copy())
            
            # --- RK4 Method ---
            k1 = self.dt * self._coupled_dynamics(t, y)
            k2 = self.dt * self._coupled_dynamics(t + 0.5 * self.dt, y + 0.5 * k1)
            k3 = self.dt * self._coupled_dynamics(t + 0.5 * self.dt, y + 0.5 * k2)
            k4 = self.dt * self._coupled_dynamics(t + self.dt, y + k3)
            
            # Update state and time
            y = y + (k1 + 2*k2 + 2*k3 + k4) / 6.0
            t = t + self.dt
        
        # Append the final state
        t_sol.append(t)
        y_sol.append(y.copy())
        
        return np.array(t_sol), np.array(y_sol).T

    def plot_results(self, t_sol, y_sol):
        """
        Generates plots for the simulation results from provided data.
        """
        Dw_sol_array = y_sol[0:self.NUM_MODES]
        v_real_sol = y_sol[2*self.NUM_MODES]
        v_imag_sol = y_sol[2*self.NUM_MODES + 1]
        
        detuning_total_sol = np.sum(Dw_sol_array, axis=0)
        v_mag_sol = np.sqrt(v_real_sol**2 + v_imag_sol**2)
        
        plt.figure(figsize=(12, 10))

        plt.subplot(3, 1, 1)
        plt.plot(t_sol, detuning_total_sol, label='Total Detuning, $\sum \Delta\omega_i$')
        plt.title('Total Mechanical Detuning')
        plt.xlabel('Time (s)')
        plt.ylabel('Detuning ($\Delta\omega$)')
        plt.grid(True)
        plt.legend()

        plt.subplot(3, 1, 2)
        plt.plot(t_sol, v_mag_sol, label='Cavity Voltage Magnitude, $|V|$')
        plt.title('Cavity Voltage')
        plt.xlabel('Time (s)')
        plt.ylabel('Voltage Magnitude (|V|)')
        plt.grid(True)
        plt.legend()
        
        plt.subplot(3, 1, 3)
        plt.plot(t_sol, self._V_forward_drive(t_sol), label='Forward Voltage, $V_F$')
        plt.title('Forward Voltage Drive')
        plt.xlabel('Time (s)')
        plt.ylabel('Voltage (V)')
        plt.grid(True)
        plt.legend()

        plt.tight_layout()
        plt.show()

# --- Example of how to use the RK4 solver ---
if __name__ == "__main__":
    # Create an instance of the simulator
    simulator = CavitySimulator()
    
    # Run the full simulation with the custom RK4 solver
    t_solution, y_solution = simulator.run_with_rk4()
    
    # Plot the results
    simulator.plot_results(t_solution, y_solution)